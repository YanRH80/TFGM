  author = {Salvador, Fernando and Trevi{\~n}o, Bego{\~n}a and {Chamorro-Tojeiro}, Sandra and {S{\'a}nchez-Montalv{\'a}}, Adri{\'a}n and {Herrero-Mart{\'i}nez}, Juan Mar{\'i}a and {Rodr{\'i}guez-Guardado}, Azucena and {Serre-Delcor}, N{\'u}ria and Torr{\'u}s, Diego and Goikoetxea, Josune and Zubero, Zuri{\~n}e and Velasco, Mar{\'i}a and Sulleiro, Elena and Molina, Israel and {L{\'o}pez-V{\'e}lez}, Rogelio and {P{\'e}rez-Molina}, Jos{\'e} Antonio and {on behalf the +REDIVI Collaborative Network}},
