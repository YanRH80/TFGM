  doi = {10.1016/S1473-3099(24)00595-4},
  urldate = {2026-03-17},
  abstract = {Strongyloidiasis is a soil-transmitted helminthiasis that is estimated to affect 300--600 million persons across Asia, Africa, South and Central America, and the Pacific. This neglected parasitic disease is most known for its ability to persist as a lifelong infection due to autoinfection, and for its risk of hyperinfection and disseminated disease during immunosuppression that has a {$>$}60\% case fatality. Despite the large global burden of strongyloidiasis, there have been no large-scale public health programs or WHO guidelines directed towards its control and elimination. However, over the past decade, key scientific and policy changes along with requests from endemic countries has led to WHO incorporating strongyloidiasis into its 2021--2030 roadmap and public health targets for control and elimination of neglected tropical diseases. In 2024, WHO published its first-ever guideline on public health control of strongyloidiasis with a single recommendation: In endemic settings with prevalence of Strongyloides stercoralis infection {$\geq$} 5\% (measured either by Baermann or agar plate culture using stool specimens), WHO conditionally recommends mass drug administration with single-dose ivermectin (200 {$\mu$}g/kg oral therapy) in all age groups from 5 years and above to reduce strongyloidiasis. This article, written by the 2023--2024 Strongyloidiasis Guidelines Development Group along with WHO colleagues and international experts, presents a summary of the recently published WHO guideline recommendation for strongyloidiasis along with the supporting evidence, considerations for public health implementation, and future research needs.},
  pmcid = {PMC11871984},
  pmid = {39481419},
  file = {/Users/yanrodriguez/Zotero/storage/YVZ2W6KX/Lo et al. - 2025 - Review of the World Health Organization guideline on preventive chemotherapy for public health contr.pdf}
}
